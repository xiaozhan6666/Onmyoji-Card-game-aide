{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sample_kind": {
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "context_confirmed": {
      "type": "boolean"
    },
    "scope_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "season_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "shikigami_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,9}$"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "captured_at": {
            "type": "string"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "key",
          "path",
          "captured_at",
          "size"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "identity_confirmed": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "properties": {
              "player_id": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "image",
                  "box"
                ],
                "additionalProperties": false
              },
              "grade": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "image",
                  "box"
                ],
                "additionalProperties": false
              },
              "bailian_points": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "image",
                  "box"
                ],
                "additionalProperties": false
              },
              "cumulative_wins": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "image",
                  "box"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "player_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "grade": {
                "enum": [
                  5,
                  6,
                  7,
                  8,
                  9,
                  10
                ]
              },
              "bailian_points": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              },
              "cumulative_wins": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "identity_confirmed",
          "fields"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "sample_kind",
    "context_confirmed",
    "scope_key",
    "season_key",
    "shikigami_id",
    "images",
    "rows"
  ],
  "additionalProperties": false
}
